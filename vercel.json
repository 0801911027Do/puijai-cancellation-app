{
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*\\.(?:webp|png|jpg|jpeg|svg|ico|woff2?))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/((?!api/|.*\\.(?:webp|png|jpg|jpeg|svg|ico|txt|xml|json|js|css|woff2?|ttf)).*)", "destination": "/index.html" }
  ]
}
